  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vite": "6.4.5",
    "wrangler": "^4.158.0"
  }
